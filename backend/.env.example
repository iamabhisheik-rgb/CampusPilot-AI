# Choose which LLM provider you want to use by filling in its respective API key.
# The backend will auto-detect the available key in order of: Gemini -> OpenAI -> Anthropic.
# If no keys are specified, a mock text stream will be returned for testing purposes.

# Google Gemini API Key (Get it from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Get it from OpenAI Platform)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key (Get it from Anthropic Console)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
